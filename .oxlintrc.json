{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": { "correctness": "error" },
    "rules": {
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }]
    },
    "ignorePatterns": [
        "**/*.js",
        "**/*.cjs",
        "**/*.mjs",
        "website/**",
        "plugins-extra/**",
        "plugins-personal/**",
        "**/verification/**/out/**",
        "**/dist/**"
    ]
}
