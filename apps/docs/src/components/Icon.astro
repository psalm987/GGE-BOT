---
import { isIcon } from "../data/icons.ts"

interface Props {
    id: string
    size?: number
    class?: string
}

const urls = import.meta.glob<string>("../../../../packages/ui/src/icons/*.svg", { eager: true, query: "?url", import: "default" })
const { id, size = 24, class: className } = Astro.props
const src = urls[`../../../../packages/ui/src/icons/${id}.svg`]
if (!isIcon(id) || !src) throw new Error(`The icon "${id}" is not in packages/ui/src/icons`)
---

<img class:list={["gge-icon", className]} src={src} width={size} height={size} alt="" loading="lazy" decoding="async" draggable="false" />
