---
import Icon from "./Icon.astro"
import { nextOccurrence, pageHref, routeLocale, termsFor } from "../data/runtime.ts"

interface Props {
    id: string
}

const { id } = Astro.props
const t = Astro.locals.t
const locale = routeLocale(Astro)
const entry = (await termsFor(locale)).find(term => term.id === id)
if (!entry) throw new Error(`The term "${id}" is not in the term registry`)
const popId = `term-${id}-${nextOccurrence(Astro.request, id)}`
const nameId = `${popId}-name`
---

<span class="gge-term"><button type="button" class="gge-term__btn" popovertarget={popId} aria-expanded="false" aria-controls={popId}><slot /></button><span popover="auto" id={popId} class="gge-term__pop" role="group" aria-labelledby={nameId} data-pagefind-ignore><span class="gge-term__name" id={nameId}>{entry.term}</span><span class="gge-term__short">{entry.short}</span>{entry.image && <Icon class="gge-term__image" id={entry.image} size={48} />}<span class="gge-term__actions"><a class="gge-term__more" href={pageHref(locale, "glossary", id)}>{t("gge.term.readMore")}</a><button type="button" class="gge-term__close" popovertarget={popId} popovertargetaction="hide">{t("gge.term.close")}</button></span></span></span>
