# Behind Dokploy: Traefik terminates TLS for app.<domain> and admin.<domain>
# and forwards plain HTTP here with the original Host header. Grafana gets its
# own Dokploy domain and does not pass through Caddy.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(spa) {
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

http://app.{$DOMAIN} {
	import security
	handle /rpc/* {
		reverse_proxy api:3000
	}
	handle /healthz {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/client
		import spa
	}
}

http://admin.{$DOMAIN} {
	import security
	handle /admin/rpc/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/admin
		import spa
	}
}
