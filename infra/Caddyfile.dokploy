# Behind Dokploy: Traefik terminates TLS for app.<domain>, admin.<domain> and docs.<domain>
# and forwards plain HTTP here with the original Host header. Grafana gets its
# own Dokploy domain and does not pass through Caddy.
{
	auto_https off
	admin off
	servers {
		# Traefik is the private-address peer. Cloudflare sits in front of it and puts the
		# visitor's address in CF-Connecting-IP; Traefik replaces X-Forwarded-For with the
		# Cloudflare edge's address, so that header alone names Cloudflare, not the visitor.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# The API reads req.ip from X-Forwarded-For; hand it the one resolved address.
(api) {
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(spa) {
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

http://app.{$DOMAIN} {
	import security
	handle /rpc/* {
		import api
	}
	handle /webhooks/* {
		import api
	}
	handle /healthz {
		import api
	}
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle {
		root * /srv/client
		import spa
	}
}

http://admin.{$DOMAIN} {
	import security
	handle /admin/rpc/* {
		import api
	}
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle {
		root * /srv/admin
		import spa
	}
}

http://docs.{$DOMAIN} {
	import security
	encode zstd gzip
	root * /srv/docs
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html
	file_server
	# A missing page under /de/ gets the German 404 page, and anything else the English one.
	handle_errors 404 {
		@localized path_regexp locale ^/([a-z]{2})/
		rewrite @localized /{re.locale.1}/404/index.html
		try_files {path} /404.html
		file_server
	}
}
