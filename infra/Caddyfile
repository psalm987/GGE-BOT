# DOMAIN comes from the environment, e.g. example.com. Caddy gets and renews
# certificates for app., admin. and grafana. on its own.
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(spa) {
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

app.{$DOMAIN} {
	import security
	handle /rpc/* {
		reverse_proxy api:3000
	}
	handle /webhooks/* {
		reverse_proxy api:3000
	}
	handle /healthz {
		reverse_proxy api:3000
	}
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle {
		root * /srv/client
		import spa
	}
}

admin.{$DOMAIN} {
	import security
	handle /admin/rpc/* {
		reverse_proxy api:3000
	}
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle {
		root * /srv/admin
		import spa
	}
}

grafana.{$DOMAIN} {
	import security
	reverse_proxy grafana:3000
}
