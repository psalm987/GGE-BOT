{
  "uid": "gge-attacks",
  "title": "GGE · Attacks",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "gge"
  ],
  "links": [
    {
      "title": "GGE dashboards",
      "type": "dashboards",
      "tags": [
        "gge"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attacks per hour, by outcome",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(bot_attacks_total[15m])) * 3600",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Refusals per hour, by reason (goal: 0)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(bot_attack_refusals_total[15m])) * 3600",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Idle seconds per running bot-second, by cause",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cause) (rate(bot_attack_idle_seconds_total[15m])) / sum(bot_workers{state=\"running\"})",
          "legendFormat": "{{cause}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue pauses per hour, by trigger",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(bot_attack_pauses_total[15m])) * 3600",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Round trip p50 / p95, by kingdom",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, kingdom) (rate(bot_attack_round_trip_seconds_bucket[1h])))",
          "legendFormat": "p50 kingdom {{kingdom}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kingdom) (rate(bot_attack_round_trip_seconds_bucket[1h])))",
          "legendFormat": "p95 kingdom {{kingdom}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Time in the attack queue p50 / p95",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bot_attack_queue_wait_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bot_attack_queue_wait_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
