{
  "uid": "gge-notifications",
  "title": "GGE \u00b7 Notifications and email",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "gge"
  ],
  "links": [
    {
      "title": "GGE dashboards",
      "type": "dashboards",
      "tags": [
        "gge"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Emails pending for over 5 minutes",
      "description": "The mailer holds a notification back for at most 5 minutes to batch a burst, so a row older than that is stuck: the mailer is down or failing.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) as pending from notifications where email_state = 'pending' and created_at < now() - interval '5 minutes'"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Notifications per day, by kind",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(created_at, '1d', 0), kind as metric, count(*) as notifications from notifications where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Email outcome of each day's notifications, by state",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(created_at, '1d', 0), email_state as metric, count(*) as notifications from notifications where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Why emails were skipped or failed",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select email_state as outcome, coalesce(email_error, '(no reason recorded)') as reason, count(*) as notifications, max(created_at) as latest from notifications where email_state in ('skipped', 'failed') and $__timeFilter(created_at) group by 1, 2 order by 3 desc"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Emails that failed to send, per day (every kind)",
      "description": "Every templated email the mail provider refused: verification, password reset, notification digests and the rest, from email.send_failed audit rows.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(ts, '1d', 0), count(*) as failures from audit_log where action = 'email.send_failed' and $__timeFilter(ts) group by 1 order by 1"
        }
      ]
    }
  ]
}