{
  "uid": "gge-runs",
  "title": "GGE \u00b7 Run history",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "gge"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs started per day, by end reason",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(started_at, '1d'), coalesce(end_reason, 'running') as metric, count(*) as runs from bot_runs where $__timeFilter(started_at) group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed runs per day, by end reason",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(started_at, '1d'), end_reason as metric, count(*) as runs from bot_runs where $__timeFilter(started_at) and end_reason in ('crash', 'error', 'stale', 'banned', 'auth_failed', 'runner_lost') group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet uptime over the selected range",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(100.0 * sum(extract(epoch from least(coalesce(ended_at, now()), $__timeTo()::timestamptz) - greatest(started_at, $__timeFrom()::timestamptz))) / nullif(count(distinct account_id) * extract(epoch from $__timeTo()::timestamptz - $__timeFrom()::timestamptz), 0), 1) as \"uptime %\" from bot_runs where started_at < $__timeTo()::timestamptz and coalesce(ended_at, now()) > $__timeFrom()::timestamptz"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts in the selected range",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(sum(restarts), 0) as restarts from bot_runs where $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Accounts by current state",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select actual_state as state, count(*) as accounts from bot_status group by 1 order by 2 desc"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Run length and count, by end reason",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "median"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(end_reason, 'still running') as reason, count(*) as runs, percentile_cont(0.5) within group (order by extract(epoch from coalesce(ended_at, now()) - started_at)) as median, percentile_cont(0.95) within group (order by extract(epoch from coalesce(ended_at, now()) - started_at)) as p95 from bot_runs where $__timeFilter(started_at) group by 1 order by 2 desc"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Failed runs by server",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select s.label as server, count(*) as failures from bot_runs r join game_accounts a on a.id = r.account_id join servers s on s.id = a.server_id where $__timeFilter(r.started_at) and r.end_reason in ('crash', 'error', 'stale', 'banned', 'auth_failed', 'runner_lost') group by 1 order by 2 desc"
        }
      ]
    }
  ]
}