{
  "uid": "gge-fleet",
  "title": "GGE \u00b7 Fleet",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "gge"
  ],
  "links": [
    {
      "title": "GGE dashboards",
      "type": "dashboards",
      "tags": [
        "gge"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bots running",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bot_workers{state=\"running\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Needing attention",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bot_workers{state=~\"error|crash_loop|banned|auth_failed\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worker heap (max)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bot_worker_heap_bytes{stat=\"max\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runner event-loop lag p99",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nodejs_eventloop_lag_p99_seconds{job=\"runner\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bots by state",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (bot_workers)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker heap",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bot_worker_heap_bytes",
          "legendFormat": "{{stat}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Runs ended in the last 24 h, by reason",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(end_reason, 'still running') as reason, count(*) as runs from bot_runs where started_at > now() - interval '24 hours' group by 1 order by 2 desc"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Fleet uptime, last 24 h",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gge-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(100.0 * sum(extract(epoch from least(coalesce(ended_at, now()), now()) - greatest(started_at, now() - interval '24 hours'))) / nullif(count(distinct account_id) * 86400, 0), 1) as \"uptime %\" from bot_runs where coalesce(ended_at, now()) > now() - interval '24 hours'"
        }
      ]
    }
  ]
}