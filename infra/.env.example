# Copy to infra/.env (never commit it). See docs/deployment/env.md for every variable.
DOMAIN=example.com
ACME_EMAIL=you@example.com
GGE_VERSION=latest

# openssl rand -hex 32
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Discord channel > Edit > Integrations > Webhooks. Empty: alerts show in Grafana only.
GRAFANA_ALERT_DISCORD_WEBHOOK=

# docker compose ... run --rm migrate node tools/dev/keygen.ts   (prints all three lines)
SEAL_PUBLIC_KEY=
SEAL_PRIVATE_KEY=
# Encrypts admins' authenticator secrets. Or: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Signs the tokens that let a browser open the live-update socket. openssl rand -hex 32
CENTRIFUGO_TOKEN_SECRET=

# Resend (https://resend.com). Verify the sending domain there first (SPF/DKIM DNS records).
# Without a key the API logs emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="GGE Bot <noreply@example.com>"

MAX_ACCOUNTS=50
START_GAP_MS=2000
GAME_CLIENT_VERSION=
GAME_CLIENT_BUILD=
# Reconnect a bot after this many ms of silence from the game. Empty: off (see observability.md).
INBOUND_STALE_MS=
# Days to keep audit log entries. Empty: 365.
AUDIT_RETENTION_DAYS=
# true: an account with no proxy doesn't start, instead of connecting from this server's address.
# Empty: false (docs/deployment/operations.md#proxies).
PROXY_REQUIRED=
# Humanization flags to turn on, comma separated: pin_jitter, measured_timing, lognormal_delays, map_grid.
# Empty: all off (docs/deployment/observability.md#humanization-flags).
BOT_HUMANIZE=
# Account ids the flags above apply to, comma separated. Empty: every account.
BOT_HUMANIZE_ACCOUNTS=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BACKUP_KEEP_DAYS=14

# Encrypted off-site copies on Google Drive (docs/deployment/backup-restore.md).
# Set all four or none; an empty GDRIVE_TOKEN keeps dumps on this host only.
# Wrap the token JSON in single quotes.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_TOKEN=
BACKUP_PASSPHRASE=
BACKUP_KEEP_MONTHS=12

# Cloudflare Turnstile captcha on signup. Set both or neither; empty turns it off.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Sentry project DSNs (Settings > Projects > Client Keys). Leave empty to turn Sentry off.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Organization token (Settings > Auth Tokens). Uploads frontend source maps at build time.
SENTRY_AUTH_TOKEN=
