# Copy to infra/.env (never commit it). See docs/deployment/env.md for every variable.
DOMAIN=example.com
ACME_EMAIL=you@example.com
GGE_VERSION=latest

# openssl rand -hex 32
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# docker compose ... run --rm migrate node tools/dev/keygen.ts   (prints both lines)
SEAL_PUBLIC_KEY=
SEAL_PRIVATE_KEY=

MAX_ACCOUNTS=50
START_GAP_MS=2000
GAME_CLIENT_VERSION=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BACKUP_KEEP_DAYS=14
