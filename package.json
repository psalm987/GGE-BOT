{
  "name": "gge-bot",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:formal": "turbo run test:formal",
    "lint": "eslint . && oxlint",
    "i18n:literals": "node tools/i18n/find-literals.ts",
    "i18n:glossary": "node tools/i18n/glossary.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:formal",
    "outdated": "npm-check-updates",
    "dev": "pnpm --filter @gge/dev dev"
  },
  "dependencies": {
    "body-parser": "^2.4.0",
    "bufferutil": "^4.1.0",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "i18n": "^0.15.3",
    "undici": "^8.7.0",
    "ws": "^8.21.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "npm-check-updates": "^23.1.1",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
